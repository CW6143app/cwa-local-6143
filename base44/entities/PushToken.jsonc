{
  "name": "PushToken",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "title": "FCM Device Token"
    },
    "user_agent": {
      "type": "string",
      "title": "User Agent"
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "description": "Where this token was registered from. All three deliver through the same FCM HTTP v1 send \u2014 this is for admin visibility only.",
      "enum": [
        "web",
        "ios",
        "android"
      ],
      "default": "web"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}