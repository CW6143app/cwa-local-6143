{
  "name": "PreOrderSale",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Sale Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "delivery_notice": {
      "type": "string",
      "title": "Delivery Notice (shown big and bold)"
    },
    "pickup_info": {
      "type": "string",
      "title": "Pickup / Payment Info"
    },
    "zelle_info": {
      "type": "string",
      "title": "Zelle Email or Phone",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "cashapp_info": {
      "type": "string",
      "title": "Cash App $tag or Phone",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "active": {
      "type": "boolean",
      "title": "Pre-Order Open",
      "default": false
    },
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}