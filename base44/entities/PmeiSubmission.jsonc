{
  "name": "PmeiSubmission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "job_title": {
      "type": "string",
      "title": "Job Title"
    },
    "contact_number": {
      "type": "string",
      "title": "Contact #"
    },
    "problem_description": {
      "type": "string",
      "title": "Describe a problem or situation"
    },
    "potential_solutions": {
      "type": "string",
      "title": "Potential Solutions"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "resolved"
      ],
      "default": "submitted",
      "title": "Status"
    }
  },
  "required": [
    "name",
    "problem_description"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}