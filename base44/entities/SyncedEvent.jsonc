{
  "name": "SyncedEvent",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "title": "Day"
    },
    "month": {
      "type": "string",
      "title": "Month"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "note": {
      "type": "string",
      "title": "Note"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "url": {
      "type": "string",
      "title": "Link URL",
      "format": "uri"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}