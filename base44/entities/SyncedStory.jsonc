{
  "name": "SyncedStory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "date": {
      "type": "string",
      "title": "Date"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "image": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "url": {
      "type": "string",
      "title": "Link URL",
      "format": "uri"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}