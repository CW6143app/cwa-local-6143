{
  "name": "Disable Meeting Button",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5 21 * * 4",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "disable_meeting_button",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "disable": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "toggleMeetingButton",
            "args": {
              "action": "off"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Disable Join Meeting button",
            "description": "Second Thursday, 9:05 PM CT"
          }
        }
      }
    ]
  },
  "description": "Turns off the Join Meeting button after the meeting on the second Thursday of each month at 9:05 PM CT"
}